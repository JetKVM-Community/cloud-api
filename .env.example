# =============================================================================
# JetKVM Cloud API — Worker Secrets / Environment Variables
#
# These values are set as Cloudflare Worker secrets via:
#   wrangler secret put <NAME>
#
# For local development with `wrangler dev`, copy this file to .dev.vars.
# Bindings (D1, R2, Durable Objects) are configured in wrangler.toml.
# =============================================================================

##
## OIDC Provider.
## Device registration requires Google: the firmware hardcodes
## https://accounts.google.com (cloud.go) and rejects any other issuer with
## 400 {"error":"Invalid OIDC token"}. Any OIDC provider works for browser
## login alone.
##
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

##
## Hostnames
##
API_HOSTNAME=https://api.jetkvm.com
APP_HOSTNAME=https://app.jetkvm.com

##
## Cloudflare TURN Service
## Credentials from the Cloudflare Calls dashboard (https://dash.cloudflare.com > Calls > TURN)
##
CLOUDFLARE_TURN_ID=
CLOUDFLARE_TURN_TOKEN=

##
## Session Cookie Secret (used for HMAC-SHA256 signed cookies)
##
COOKIE_SECRET=

##
## Cloudflare R2 CDN URL
## Public URL prefix for R2-hosted firmware artifacts (e.g. https://releases.jetkvm.com)
## The R2 bucket binding itself is configured in wrangler.toml.
##
R2_CDN_URL=

# Allowed CORS Origins, split by comma
CORS_ORIGINS=https://app.jetkvm.com,http://localhost:5173

# Allowed account emails, split by comma (leave empty to allow all)
ALLOWED_IDENTITIES=

# Real IP Header for the reverse proxy (e.g. X-Real-IP), leave empty if not needed
REAL_IP_HEADER=

# ICE Servers for WebRTC, split by comma (e.g. stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302)
ICE_SERVERS=
