# =============================================================================
# Example Terraform variable values — copy to terraform.tfvars and fill in.
# DO NOT commit terraform.tfvars (it contains secrets).
#
# The OIDC client credentials, the TURN key and the session cookie secret are
# created by Terraform and read back off the resources, so they are not set here.
# =============================================================================

cloudflare_api_token = ""

# Zone hosting r2_cdn_hostname. Only needed when r2_cdn_hostname is set.
cloudflare_zone_id = ""

# ── Worker ───────────────────────────────────────────────────────────────────
worker_name = "jetkvm-cloud-api"

# Your account's workers.dev subdomain, used only to render worker_subdomain_url.
workers_dev_subdomain = ""

# ── D1 ───────────────────────────────────────────────────────────────────────
d1_database_name = "jetkvm-cloud-api"

# ── R2 ───────────────────────────────────────────────────────────────────────
r2_bucket_name     = "jetkvm-releases"
r2_bucket_location = "wnam"

# ── Hostnames (bare, no scheme; leave empty to skip) ─────────────────────────
api_hostname = "api.jetkvm.com"
app_hostname = "app.jetkvm.com"

# R2 custom domain for firmware releases; empty disables it.
# The Worker's R2_CDN_URL is derived as https://<r2_cdn_hostname>.
r2_cdn_hostname = "releases.jetkvm.com"

# ── Zero Trust Access ────────────────────────────────────────────────────────
# When true, Terraform creates an Access SaaS application and Cloudflare Access
# becomes the Worker's OIDC provider; OIDC_ISSUER, OIDC_CLIENT_ID and
# OIDC_CLIENT_SECRET are taken from that application.
#
# NOTE: device registration requires Google. The firmware hardcodes
# https://accounts.google.com in cloud.go and rejects any other issuer with
# 400 {"error":"Invalid OIDC token"}. Set enable_access = false and supply the
# Google OAuth credentials below if devices must self-register.
enable_access           = false
access_app_name         = "JetKVM Cloud API"
access_session_duration = "24h"

# Who may log in through Access. Both empty = anyone who authenticates.
access_allowed_emails        = []
access_allowed_email_domains = []

# ── External OIDC (only when enable_access = false) ───────────────────────────
# oidc_issuer        = "https://accounts.example.com"
# oidc_client_id     = ""
# oidc_client_secret = ""

# ── Cloudflare Calls (TURN) ──────────────────────────────────────────────────
# The key is minted by a POST from the http provider (see turn.tf). Set
# create_turn_key = true for exactly ONE apply, then set it back to false;
# the data source re-POSTs on every read and would mint a key each plan.
turn_app_name   = "jetkvm-cloud-api"
create_turn_key = false


# ── Worker Environment ───────────────────────────────────────────────────────
cors_origins       = "https://app.jetkvm.com"
allowed_identities = ""

# ── Worker Build / Deploy ────────────────────────────────────────────────────
worker_dist_dir        = "../dist"
worker_version_message = "Deployed via Terraform"
