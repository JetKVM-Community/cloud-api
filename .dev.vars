COOKIE_SECRET=dev-secret-change-me
R2_CDN_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_IDENTITIES=
REAL_IP_HEADER=
ICE_SERVERS=
